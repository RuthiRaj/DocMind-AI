# ==============================================================================
# DocMind AI Root Git Ignore Configuration
# ==============================================================================
# This file specifies intentionally untracked files that Git should ignore across
# the entire repository workspace.
# ==============================================================================

# Virtual Environment & Python Execution Caches
.venv/
venv/
ENV/
env/
__pycache__/
*.pyc
*.py[cod]

# Environment variables & secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo

# Artifacts & Log files
*.log
logs/
.antigravity/
scratch/

# Uploaded Files & Generated Vector Storage Data
uploads/
backend/uploads/
backend/vector_store/

# Node modules & Frontend build outputs
node_modules/
frontend/node_modules/
.next/
frontend/.next/
