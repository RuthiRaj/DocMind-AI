# ==============================================================================
# DocMind AI Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure your Groq API key:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq AI Provider Credentials & Model Configuration
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Active LLM engine (openai/gpt-oss-20b delivers 100% grounded facts with minimal token overhead)
GROQ_MODEL=openai/gpt-oss-20b

# Upstream token limit per minute (8000 TPM on Groq Free Tier for openai/gpt-oss-20b)
GROQ_TPM_LIMIT=8000

# ------------------------------------------------------------------------------
# 2. Concurrency Arbitration & Graceful Degradation
# ------------------------------------------------------------------------------
# Soft concurrency threshold (85% of 8,000 TPM = 6,800 tokens) to return instant 200 busy response
GROQ_SOFT_CAP_RATIO=0.85

# Friendly notice returned when platform experiences burst visitor traffic
GROQ_BUSY_MESSAGE="This demo is currently busy with other visitors — please try again in about a minute."

# Maximum queue wait time (seconds) before graceful fallback
GROQ_MAX_QUEUE_WAIT_SECONDS=25.0

# ------------------------------------------------------------------------------
# 3. Response Caching & Performance Optimization
# ------------------------------------------------------------------------------
# In-memory LRU response cache for repeated/normalized queries (sub-5ms response, 0 token cost)
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_MAX_ENTRIES=200

# ------------------------------------------------------------------------------
# 4. Token Budget & Context Bounding
# ------------------------------------------------------------------------------
# Preflight prompt budget allocated for system prompt + retrieved chunks + query
GROQ_PREFLIGHT_PROMPT_TOKEN_BUDGET=2500

# Reserve tokens allocated for completion generation (reasoning + answer)
GROQ_COMPLETION_RESERVE_TOKENS=1536

# Multi-turn conversation memory bounding (prevents compounding token explosion)
CONVERSATION_MAX_TURNS=2
CONVERSATION_MAX_TOKENS=350

# ------------------------------------------------------------------------------
# 5. Hybrid Retrieval & Embedding Pipeline
# ------------------------------------------------------------------------------
# Dense vector embeddings model (384-dimensional dense vectors)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Maximum chunks to retrieve during hybrid search pass
TOP_K=25

# Reciprocal Rank Fusion constant
RRF_K=60

# Optional selective LLM query expansion (disabled by default to conserve free-tier tokens)
ENABLE_SELECTIVE_QUERY_REWRITING=false

# ------------------------------------------------------------------------------
# 6. File Ingestion & Storage Constraints
# ------------------------------------------------------------------------------
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------------------------
# 7. Server & Observability Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
BACKEND_VERSION=1.0.0
