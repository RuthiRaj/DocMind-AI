# Groq AI Provider Credentials & Rate Limits
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TPM_LIMIT=6000
GROQ_QUERY_REWRITE_RESERVE_TOKENS=300

# Embedding & Vector Database Model Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# File Upload & Directory Constraints
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE=20971520

# Chunking Service Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval & RAG V2 Pipeline Configuration
TOP_K=25
ENABLE_HYBRID_SEARCH=true
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# Score Fusion Reranker Configuration (Disabled by default - RRF is primary)
ENABLE_RERANKER=false
RERANKER_TOP_K=10

# Selective Query Rewriting Configuration
ENABLE_SELECTIVE_QUERY_REWRITING=true
REWRITE_MIN_WORD_COUNT=5

# Context Management & Neighbor-Merging Cap
MAX_MERGED_CHUNKS=2
MAX_MERGED_CHUNK_CHARS=1500

# Server & Logging Configuration
LOG_LEVEL=INFO
BACKEND_VERSION=2.0.0
